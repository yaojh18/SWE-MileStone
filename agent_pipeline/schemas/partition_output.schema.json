{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swe-milestone.local/schemas/partition_output.schema.json",
  "title": "SWE-Milestone partition curator output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_kind",
    "source",
    "status",
    "subtasks",
    "test_adjustments",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_kind": {"const": "partition"},
    "source": {"$ref": "#/$defs/source"},
    "status": {"const": "partitioned"},
    "subtasks": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/subtask"}
    },
    "test_adjustments": {
      "type": "array",
      "items": {"$ref": "#/$defs/test_adjustment"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "role": {"enum": ["f2p", "n2p", "p2p"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "milestone_id", "input_hash"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "milestone_id": {"type": "string", "minLength": 1},
        "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "detail"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "behavior"],
      "properties": {
        "kind": {
          "enum": ["current_commit", "prior_commit", "following_commit", "synthesized"]
        },
        "commit": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "test_name": {"type": "string"},
        "behavior": {"type": "string", "minLength": 1}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f2p", "n2p", "p2p"],
      "properties": {
        "f2p": {"$ref": "#/$defs/test_selection"},
        "n2p": {"$ref": "#/$defs/test_selection"},
        "p2p": {"$ref": "#/$defs/test_selection"}
      }
    },
    "test_id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "test_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "include_ids", "exclude_ids"],
      "properties": {
        "mode": {"enum": ["explicit", "all_original"]},
        "include_ids": {"$ref": "#/$defs/test_id_array"},
        "exclude_ids": {"$ref": "#/$defs/test_id_array"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "explicit"}}, "required": ["mode"]},
          "then": {"properties": {"exclude_ids": {"maxItems": 0}}}
        }
      ]
    },
    "test_selection": {
      "oneOf": [
        {"$ref": "#/$defs/test_id_array"},
        {"$ref": "#/$defs/test_selector"}
      ]
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "problem_statement",
        "acceptance_criteria",
        "depends_on",
        "change_unit_ids",
        "source_loc",
        "tests",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "problem_statement": {"type": "string", "minLength": 1},
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "change_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_loc": {"type": "integer", "minimum": 100, "maximum": 1000},
        "tests": {"$ref": "#/$defs/tests"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "test_adjustment": {
      "oneOf": [
        {"$ref": "#/$defs/add_adjustment"},
        {"$ref": "#/$defs/remove_adjustment"},
        {"$ref": "#/$defs/reclassify_adjustment"}
      ]
    },
    "adjustment_base": {
      "type": "object",
      "required": ["action", "test_id", "rationale", "evidence"],
      "properties": {
        "action": {"enum": ["add", "remove", "reclassify"]},
        "test_id": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "add_adjustment": {
      "allOf": [
        {"$ref": "#/$defs/adjustment_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "test_id", "role", "applies_to", "rationale", "evidence", "provenance"],
          "properties": {
            "action": {"const": "add"},
            "test_id": {"type": "string", "minLength": 1},
            "role": {"$ref": "#/$defs/role"},
            "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "rationale": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
            "provenance": {"$ref": "#/$defs/provenance"}
          }
        }
      ]
    },
    "remove_adjustment": {
      "allOf": [
        {"$ref": "#/$defs/adjustment_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "test_id", "rationale", "evidence"],
          "properties": {
            "action": {"const": "remove"},
            "test_id": {"type": "string", "minLength": 1},
            "rationale": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
          }
        }
      ]
    },
    "reclassify_adjustment": {
      "allOf": [
        {"$ref": "#/$defs/adjustment_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "test_id", "from_role", "to_role", "rationale", "evidence"],
          "properties": {
            "action": {"const": "reclassify"},
            "test_id": {"type": "string", "minLength": 1},
            "from_role": {"$ref": "#/$defs/role"},
            "to_role": {"$ref": "#/$defs/role"},
            "rationale": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
          }
        }
      ]
    }
  }
}
