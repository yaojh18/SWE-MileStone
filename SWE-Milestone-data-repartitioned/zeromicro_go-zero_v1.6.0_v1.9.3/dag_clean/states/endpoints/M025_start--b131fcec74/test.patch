+func TestConvertStringDataType(t *testing.T) {
+	type (
+		input struct {
+			dataType      string
+			isDefaultNull bool
+			unsigned      bool
+			strict        bool
+		}
+		result struct {
+			goType    string
+			thirdPkg  string
+			isPQArray bool
+		}
+	)
+	var testData = []struct {
+		input input
+		want  result
+	}{
