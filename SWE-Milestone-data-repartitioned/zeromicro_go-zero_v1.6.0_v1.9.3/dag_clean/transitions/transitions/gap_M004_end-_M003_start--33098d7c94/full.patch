+func TestConvertStringDataType(t *testing.T) {
+	type (
+		input struct {
+			dataType      string
+			isDefaultNull bool
+			unsigned      bool
+			strict        bool
+		}
+		result struct {
+			goType    string
+			thirdPkg  string
+			isPQArray bool
+		}
+	)
+	var testData = []struct {
+		input input
+		want  result
+	}{
+		{
+			input: input{
+				dataType:      "bigint",
+				isDefaultNull: false,
+				unsigned:      false,
+				strict:        false,
+			},
+			want: result{
+				goType: "int64",
+			},
+		},
+		{
+			input: input{
