+				isDefaultNull: true,
+				unsigned:      false,
+				strict:        false,
+			},
+			want: result{
+				goType: "sql.NullInt64",
+			},
+		},
+		{
+			input: input{
+				dataType:      "bigint",
+				isDefaultNull: false,
+				unsigned:      true,
+				strict:        false,
+			},
+			want: result{
