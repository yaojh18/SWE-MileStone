+		Cursor: "my-cursor",
+	}
+
+	paramBytes, _ := json.Marshal(params)
+	req := Request{
+		JsonRpc: jsonRpcVersion,
+		ID:      1,
+		Method:  methodToolsList,
+		Params:  paramBytes,
