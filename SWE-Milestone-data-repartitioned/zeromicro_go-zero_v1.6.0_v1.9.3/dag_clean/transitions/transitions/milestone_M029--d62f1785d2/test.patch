+			"input": "test-input",
+		},
+	}
+
+	paramBytes, _ := json.Marshal(params)
+	req := Request{
+		JsonRpc: jsonRpcVersion,
+		ID:      1,
+		Method:  methodToolsCall,
+		Params:  paramBytes,
+	}
+
+	// Process the tool call
