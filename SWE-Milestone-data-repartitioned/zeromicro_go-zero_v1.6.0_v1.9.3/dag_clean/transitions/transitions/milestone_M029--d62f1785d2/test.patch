+
+	err := mock.server.RegisterTool(mapTool)
+	require.NoError(t, err)
+
+	// Create a client
+	client := addTestClient(mock.server, "test-client", true)
+
+	// Create a tool call request
+	params := struct {
+		Name      string         `json:"name"`
+		Arguments map[string]any `json:"arguments"`
