+// TestToolCallMapResult tests a tool that returns a map[string]any result
+func TestToolCallMapResult(t *testing.T) {
+	mock := newMockMcpServer(t)
+	defer mock.shutdown()
+
+	// Register a tool that returns a map
+	mapTool := Tool{
+		Name:        "map.tool",
