new file mode 100644
index 0000000000000000000000000000000000000000..2724aa6a2bd907650ad599d582a57f06702c61c8
--- /dev/null
+++ b/core/conf/validate.go
@@ -0,0 +1,12 @@
+package conf
+
+import "github.com/zeromicro/go-zero/core/validation"
+
+// validate validates the value if it implements the Validator interface.
+func validate(v any) error {
+	if val, ok := v.(validation.Validator); ok {
+		return val.Validate()
+	}
+
+	return nil
