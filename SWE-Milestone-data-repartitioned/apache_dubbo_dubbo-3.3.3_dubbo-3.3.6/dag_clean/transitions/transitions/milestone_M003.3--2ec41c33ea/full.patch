+    @Test
+    void testManyToMany_success() throws InterruptedException {
+        CallStreamObserver<String> responseObserver = mock(CallStreamObserver.class);
+
+        Function<Multi<String>, Multi<String>> func = multi -> multi.map(s -> s + "-resp");
