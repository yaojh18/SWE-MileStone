-        let is_valid_scheme_char = |byte| match byte {
-            b'0'..=b'9' | b'A'..=b'Z' | b'a'..=b'z' | b'+' | b'-' | b'.' => {
-                true
-            }
-            _ => false,
-        };
-        if !scheme.iter().all(|&b| is_valid_scheme_char(b)) {
-            return Err(err_invalid_scheme);
-        }
-        Ok(())
-    }
-}
