+        HyperlinkConfig(Arc::new(HyperlinkConfigInner { env, format }))
+    }
+
+    /// Returns the hyperlink environment in this configuration.
+    pub(crate) fn environment(&self) -> &HyperlinkEnvironment {
+        &self.0.env
