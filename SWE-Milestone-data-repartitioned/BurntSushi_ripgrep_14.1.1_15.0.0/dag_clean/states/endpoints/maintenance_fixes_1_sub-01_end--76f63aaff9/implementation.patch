-                    } else {
-                        builder.append_char(ch);
-                        State::Verbatim
-                    }
-                }
-                State::VerbatimCloseVariable => {
-                    if ch == '}' {
-                        builder.append_char('}');
-                        State::Verbatim
-                    } else {
-                        return Err(err(InvalidCloseVariable));
-                    }
-                }
-                State::OpenVariable => {
-                    if ch == '{' {
-                        builder.append_char('{');
-                        State::Verbatim
-                    } else {
-                        name.clear();
-                        if ch == '}' {
-                            builder.append_var(&name)?;
-                            State::Verbatim
-                        } else {
-                            name.push(ch);
-                            State::InVariable
-                        }
-                    }
-                }
-                State::InVariable => {
-                    if ch == '}' {
-                        builder.append_var(&name)?;
-                        State::Verbatim
-                    } else {
-                        name.push(ch);
-                        State::InVariable
-                    }
-                }
-            };
-        }
-        match state {
-            State::Verbatim => builder.build(),
-            State::VerbatimCloseVariable => Err(err(InvalidCloseVariable)),
-            State::OpenVariable | State::InVariable => {
-                Err(err(UnclosedVariable))
-            }
-        }
-    }
-}
