-    /// Callers may also set the line and column number using the mutator
-    /// methods.
-    pub(crate) fn new(path: &'a HyperlinkPath) -> Values<'a> {
-        Values { path, line: None, column: None }
-    }
-
-    /// Sets the line number for these values.
