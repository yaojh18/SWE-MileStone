-    use super::*;
-
-    #[test]
-    fn build_format() {
-        let format = FormatBuilder::new()
-            .append_slice(b"foo://")
-            .append_slice(b"bar-")
-            .append_slice(b"baz")
-            .append_var("path")
-            .unwrap()
-            .build()
-            .unwrap();
