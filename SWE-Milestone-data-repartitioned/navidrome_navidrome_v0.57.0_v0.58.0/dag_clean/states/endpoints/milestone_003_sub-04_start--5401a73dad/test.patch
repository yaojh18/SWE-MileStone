+
+describe('AlbumDatesField', () => {
+  test('renders nothing when yearRange is "0"', () => {
+    const record = {
+      maxYear: '0',
+      releaseDate: '2020-01-01',
+    }
+
+    vi.mocked(formatRange).mockReturnValue('0')
+
+    const { container } = render(
+      <RecordContextProvider value={record}>
