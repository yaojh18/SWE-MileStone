[
  {
    "name": "default",
    "test_states": ["start", "end"],
    "test_cmd": "ginkgo --json-report=/output/{output_file} -r --keep-going --tags netgo --timeout 600s ./... 2>&1",
    "framework": "ginkgo",
    "description": "Ginkgo tests with spec-level granularity (600s suite timeout)"
  },
  {
    "name": "frontend",
    "test_states": ["start", "end"],
    "test_cmd": "cd /testbed/ui && npm test -- --reporter=json --outputFile=/output/{output_file} 2>&1",
    "framework": "vitest",
    "description": "Vitest frontend tests with JSON report"
  }
]
