+)
+plt.scatter(X1[:, 0], X1[:, 1], marker="o", c=Y1, s=25, edgecolor="k")
+
+plt.subplot(322)
+plt.title("Two informative features, one cluster per class", fontsize="small")
+X1, Y1 = make_classification(
