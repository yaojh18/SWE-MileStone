-            f"neighbors in a missing from b: {missing_from_b}\n"
-            f"dist_row_a={dist_row_a}\n"
-            f"dist_row_b={dist_row_b}\n"
-            f"indices_row_a={indices_row_a}\n"
-            f"indices_row_b={indices_row_b}\n"
