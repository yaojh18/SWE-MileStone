-    ones_prime_M = np.ones_like(K_test) / K.shape[0]
-    K_test_centered = (
-        K_test - ones_prime_M @ K - K_test @ ones_M + ones_prime_M @ K @ ones_M
-    )
-    assert_allclose(kernel_centerer.transform(K_test), K_test_centered)
