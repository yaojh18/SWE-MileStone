-@pytest.mark.parametrize("use_sparse", [False, True])
-@pytest.mark.parametrize("csr_container", CSR_CONTAINERS)
-def test_cross_validate(use_sparse: bool, csr_container):
-    # Compute train and test mse/r2 scores
