-
-    external = d.children_right == TREE_LEAF
-    internal = np.logical_not(external)
-
-    assert_array_equal(
-        d.feature[internal], s.feature[internal], message + ": inequal features"
-    )
-    assert_array_equal(
-        d.threshold[internal], s.threshold[internal], message + ": inequal threshold"
