-        s.node_count == d.node_count
-    ), "{0}: inequal number of node ({1} != {2})".format(
-        message, s.node_count, d.node_count
-    )
-
-    assert_array_equal(
-        d.children_right, s.children_right, message + ": inequal children_right"
