-    X_csr, Y_csr = csr_container(X), csr_container(Y)
-
-    # Haversine is not supported by scipy.special.distance.{cdist,pdist}
-    # So we reimplement it to have a reference.
-    def haversine_slow(x1, x2):
-        return 2 * np.arcsin(
-            np.sqrt(
-                np.sin(0.5 * (x1[0] - x2[0])) ** 2
