diff --git a/crates/nu-cmd-lang/src/core_commands/attr/complete.rs b/crates/nu-cmd-lang/src/core_commands/attr/complete.rs
new file mode 100644
index 0000000000000000000000000000000000000000..252b0525b5feb05879f0fa97a6de9183620de393
--- /dev/null
