+            cwd: dirs.test(),
+            format!("if {cond} {{ echo 'hey' }} else {{ echo 'ho' }} out> result.txt")
+        );
+        assert!(actual.status.success());
+        assert_eq!(
+            file_contents(dirs.test().join("result.txt")).trim(),
+            stdout_file_body
+        );
