+            }
+            (None, Some(_)) => {
+                // lhs is shorter than rhs, so rhs cannot be a prefix of lhs
+                return None;
+            }
+            (None, None) => {
+                // Both paths have the same components, relative path is empty
+                return Some(std::path::PathBuf::new());
+            }
+        }
     }
