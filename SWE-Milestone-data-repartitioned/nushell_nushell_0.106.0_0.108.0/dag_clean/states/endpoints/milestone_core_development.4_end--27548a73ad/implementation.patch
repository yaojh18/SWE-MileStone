+            // IMPORTANT: This allocation must be freed or transferred to ownership before leaving this scope.
+            // SAFETY: `layout` has non-zero size (at least 4 for one u32).
+            let ptr = unsafe { alloc(layout) as *mut MIB_TCPTABLE2 };
+            assert!(!ptr.is_null());
