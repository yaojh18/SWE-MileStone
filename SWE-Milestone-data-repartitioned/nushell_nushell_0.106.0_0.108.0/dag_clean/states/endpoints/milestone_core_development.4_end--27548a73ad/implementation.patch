+            // SAFETY:
+            // - `ptr` is non-null, properly aligned, and points to `size` bytes.
+            // - `size_pointer` still points to `size` from the first call.
+            let ret_code = unsafe { GetTcpTable2(Some(ptr), size_pointer, false) };
