+            Value::test_float(3.141592653589793),
+            Value::test_float(3.1415926535897927),
+        ),
+    ];
+
+    for value in values {
+        assert!(matches!(
+            value.0.eq(Span::test_data(), &value.1, Span::test_data()),
+            Ok(Value::Bool { val: true, .. })
+        ));
+
+        assert!(matches!(
+            value.1.eq(Span::test_data(), &value.0, Span::test_data()),
+            Ok(Value::Bool { val: true, .. })
+        ));
+    }
+}
