+    /// create a `UniqueString`.
+    #[inline]
+    pub fn from_fmt(arguments: Arguments) -> Self {
+        Self(byteyarn::Yarn::from_fmt(arguments))
+    }
+}
+
+impl AsRef<str> for UniqueString {
+    #[inline]
+    fn as_ref(&self) -> &str {
+        self.as_str()
+    }
+}
+
+impl Borrow<str> for UniqueString {
+    #[inline]
+    fn borrow(&self) -> &str {
+        self.as_str()
+    }
+}
+
