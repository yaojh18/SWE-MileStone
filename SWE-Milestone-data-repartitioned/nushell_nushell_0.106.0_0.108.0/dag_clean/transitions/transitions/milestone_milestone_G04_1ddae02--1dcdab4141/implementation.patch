+        "parse_binary_with_multi_byte_char",
+    ]
+
+    for test_name in tests_to_comment:
+        # Find the test function and comment it out
+        pattern = rf'(#\[test\]\s*pub fn {test_name}\(\).*?)(\n#\[test\]|\nmod\s|\Z)'
