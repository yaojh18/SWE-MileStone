+def patch_test_parser():
+    """Comment out tests that use ParseError::InvalidBinaryString which doesn't exist in START state."""
+    filepath = "/testbed/crates/nu-parser/tests/test_parser.rs"
+    if not os.path.exists(filepath):
+        return
