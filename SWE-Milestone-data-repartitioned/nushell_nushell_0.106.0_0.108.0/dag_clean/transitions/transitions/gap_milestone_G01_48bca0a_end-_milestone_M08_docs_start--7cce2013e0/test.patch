+        (Value::test_float(1e-16), Value::test_float(0.0)),
+        (
+            Value::test_float((1e16 + 1.0) - 1e16),
+            Value::test_float(0.0),
+        ),
+        (
+            Value::test_float(10000000000000000.0),
+            Value::test_float(10000000000000002.0),
+        ),
