+#[cfg(test)]
+mod test_is_windows_device_path {
+    use crate::is_windows_device_path;
+    use std::path::Path;
+
+    #[cfg_attr(not(windows), ignore = "only for Windows")]
+    #[test]
+    fn device_namespace() {
