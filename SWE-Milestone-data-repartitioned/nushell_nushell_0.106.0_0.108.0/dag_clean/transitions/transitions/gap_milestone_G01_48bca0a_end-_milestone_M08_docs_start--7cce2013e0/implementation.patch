+    }
+
+    #[cfg_attr(not(windows), ignore = "only for Windows")]
+    #[test]
+    fn absolute_path() {
+        assert!(!is_windows_device_path(Path::new(r"\dir\file")))
+    }
+
+    #[cfg_attr(not(windows), ignore = "only for Windows")]
+    #[test]
+    fn unc_path() {
+        assert!(!is_windows_device_path(Path::new(r"\\server\share")))
+    }
+
+    #[cfg_attr(not(windows), ignore = "only for Windows")]
+    #[test]
+    fn verbatim_path() {
+        assert!(!is_windows_device_path(Path::new(r"\\?\dir\file")))
+    }
+}
