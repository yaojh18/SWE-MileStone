-
-  if ($artifacts | is-empty) {
-    error make {
-      msg: $"No artifacts"
-      label: {
-        text: $"no artifacts for PR match criteria"
-        span: $span
-      }
-      help: "Note that artifacts are deleted after 14 days"
-    }
-  }
-
-  $artifacts
-}
