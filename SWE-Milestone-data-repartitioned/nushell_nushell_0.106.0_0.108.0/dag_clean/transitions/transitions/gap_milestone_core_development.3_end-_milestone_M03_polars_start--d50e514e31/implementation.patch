+        Path::new("COM¹"),
+        Path::new("COM²"),
+        Path::new("COM³"),
+        Path::new("LPT1"),
+        Path::new("LPT2"),
+        Path::new("LPT3"),
+        Path::new("LPT4"),
+        Path::new("LPT5"),
+        Path::new("LPT6"),
+        Path::new("LPT7"),
+        Path::new("LPT8"),
+        Path::new("LPT9"),
+        Path::new("LPT¹"),
+        Path::new("LPT²"),
+        Path::new("LPT³"),
+    ];
+    if special_paths.contains(&path) {
+        return true;
+    }
