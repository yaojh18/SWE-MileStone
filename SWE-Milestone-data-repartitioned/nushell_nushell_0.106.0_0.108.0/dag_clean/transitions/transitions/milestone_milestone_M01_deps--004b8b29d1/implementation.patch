+        let used_ports: HashSet<u16> = table
+            .table
+            .iter()
+            .map(|row| row.dwLocalPort as u16)
+            .map(|raw| {
+                // Convert from network byte order to host byte order.
+                // SAFETY: `raw` is the exact value returned by the API for a port.
+                unsafe { ntohs(raw) }
+            })
+            .collect();
