+        commands
+            .map(|(filename, path, cmd_type)| entry(filename, path, cmd_type, Span::new(0, 0)))
+            .collect()
+    } else {
+        commands
+            .unique_by(|x| x.0.clone())
+            .map(|(filename, path, cmd_type)| entry(filename, path, cmd_type, Span::new(0, 0)))
