+            "mean" => Ok(polars::prelude::mean("*")),
+            "median" => Ok(polars::prelude::median("*")),
+            "count" => Ok(polars::prelude::len()),
+            "len" => Ok(polars::prelude::len()),
+            "last" => Ok(polars::prelude::last().as_expr()),
