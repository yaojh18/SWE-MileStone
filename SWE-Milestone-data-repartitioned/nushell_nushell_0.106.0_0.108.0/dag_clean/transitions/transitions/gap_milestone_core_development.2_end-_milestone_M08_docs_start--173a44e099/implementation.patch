+#[derive(Clone)]
+pub struct Attr;
+
+impl Command for Attr {
+    fn name(&self) -> &str {
+        "attr"
+    }
+
+    fn signature(&self) -> Signature {
+        Signature::build("attr")
+            .category(Category::Core)
+            .input_output_types(vec![(Type::Nothing, Type::String)])
