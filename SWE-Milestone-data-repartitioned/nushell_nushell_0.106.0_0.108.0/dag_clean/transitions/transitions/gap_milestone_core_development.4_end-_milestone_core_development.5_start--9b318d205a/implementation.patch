+        );
+
+        let spanned_str: Spanned<String> = Spanned {
+            item: "string(/elt/@xml:lang)".to_string(),
+            span: Span::test_data(),
+        };
+
+        let actual = query(&call, &text, Some(spanned_str), None).expect("test should not fail");
+
+        assert_eq!(actual, Value::test_string("en"));
+    }
 }
