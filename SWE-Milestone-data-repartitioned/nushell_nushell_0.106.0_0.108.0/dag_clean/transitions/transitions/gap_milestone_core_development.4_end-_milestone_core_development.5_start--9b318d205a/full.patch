-# ```nushell
-# running `toolkit fmt`
-# running `toolkit clippy`
-# ...
-# error: redundant clone
-#    --> crates/nu-command/src/formats/to/nuon.rs:134:71
-#     |
-# 134 |                 let headers_output = headers.join(&format!("x {}", "").to_string());
-#     |                                                                       ^^^^^^^^^^^^ help: remove this
-#     |
-# note: this value is dropped without further use
