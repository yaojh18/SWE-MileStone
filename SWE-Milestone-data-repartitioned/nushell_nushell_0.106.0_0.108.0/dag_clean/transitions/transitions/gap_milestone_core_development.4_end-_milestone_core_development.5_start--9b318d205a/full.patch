-        else if $fail_fmt         { [false    null null null] }
-        else if $fail_clippy      { [true     false    null null] }
-        else if $fail_test        { [true     true     false    null] }
-        else if $fail_test_stdlib { [true     true     true     false] }
-        else                      { [null null null null] }
-        | wrap success
