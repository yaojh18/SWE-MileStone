-# return a report about the check stage
-#
-# - fmt comes first
-# - then clippy
-# - and finally the tests
-#
-# without any option, `report` will return an empty report.
-# otherwise, the truth values will be incremental, following
-# the order above.
-def report [
-    --fail-fmt
-    --fail-clippy
-    --fail-test
-    --fail-test-stdlib
-    --no-fail
-] {
