+    #[inline]
+    fn case_sensitive(self) -> Self::Wrapper<CaseSensitive> {
+        CasedRecord::<CaseSensitive>::from_record(self)
+    }
+
+    #[inline]
+    fn case_insensitive(self) -> Self::Wrapper<CaseInsensitive> {
+        CasedRecord::<CaseInsensitive>::from_record(self)
+    }
