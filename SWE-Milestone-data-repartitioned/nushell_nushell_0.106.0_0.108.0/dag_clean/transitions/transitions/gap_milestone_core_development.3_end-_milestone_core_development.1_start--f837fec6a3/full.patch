+fn loop_try_break_should_pop_error_handlers() {
+    let output = nu!(r#"
+    do {
+        loop {
+            try {
+                break
+            } catch {
+                print 'jumped to catch block'
+                return
+            }
+        }
+        error make -u {msg: "success"}
+    }
+    "#);
+
+    assert!(!output.status.success(), "error was caught");
+    assert!(output.err.contains("success"));
