-#!/usr/bin/env python3
-"""
-Fix custom_completion field compatibility for Flag and PositionalArg structs.
-
-This script:
-1. Adds DeclId to imports in signature.rs
-2. Adds custom_completion: Option<DeclId> field to Flag and PositionalArg structs
-3. Adds custom_completion: None to all struct instantiations
-"""
-
-import os
-import re
-from pathlib import Path
-
-
-def fix_signature_rs(path: Path):
-    """Fix signature.rs to add the custom_completion field."""
-    content = path.read_text()
-
-    # Skip if already fixed
-    if "custom_completion" in content:
-        print(f"  Skipping {path} - already has custom_completion")
-        return False
-
-    # Add DeclId to imports (only in the use crate::{...} statement)
-    content = re.sub(
-        r'(use crate::\{\s*\n?\s*)BlockId,',
-        r'\1BlockId, DeclId,',
-        content
-    )
-
-    # Add custom_completion field to Flag struct (after default_value line)
-    content = re.sub(
-        r'(pub struct Flag \{[^}]*pub default_value: Option<Value>,)',
-        r'\1\n    pub custom_completion: Option<DeclId>,',
-        content,
-        flags=re.DOTALL
-    )
-
-    # Add custom_completion field to PositionalArg struct (after default_value line)
-    content = re.sub(
-        r'(pub struct PositionalArg \{[^}]*pub default_value: Option<Value>,)',
-        r'\1\n    pub custom_completion: Option<DeclId>,',
-        content,
-        flags=re.DOTALL
-    )
-
-    path.write_text(content)
-    print(f"  Fixed struct definitions in {path}")
-    return True
-
-
-def fix_struct_instantiations(root_dir: Path):
-    """Add custom_completion: None to all Flag and PositionalArg instantiations."""
-    fixed_files = 0
-
-    for rs_file in root_dir.rglob("*.rs"):
-        if "target" in str(rs_file):
-            continue
-
-        try:
-            content = rs_file.read_text()
-        except:
-            continue
-
-        # Skip if already has custom_completion: None, which means the fix was already applied
-        # Note: Don't skip based on just "custom_completion:" since the code may already use this variable name
-        if re.search(r'default_value:.*\n\s*custom_completion: None,', content):
-            continue
-
-        # Skip if file doesn't contain Flag or PositionalArg instantiations
-        if "Flag {" not in content and "PositionalArg {" not in content:
-            continue
-
-        lines = content.split('\n')
-        new_lines = []
-        modified = False
-        i = 0
-
-        while i < len(lines):
-            line = lines[i]
-            new_lines.append(line)
-
-            # Check if this line contains default_value assignment that ends a struct
-            # Pattern: "default_value: None," or "default_value: Some(...),"
-            # But NOT "pub default_value:" which is a struct definition, not instantiation
-            if 'default_value:' in line and line.rstrip().endswith(',') and 'pub default_value' not in line:
-                # Look back to see if we're inside a Flag or PositionalArg instantiation
-                # by checking for opening brace of these structs
-                in_struct = False
-                struct_indent = 0
-                current_indent = len(line) - len(line.lstrip())
-
-                for j in range(i - 1, max(i - 30, -1), -1):
-                    prev_line = lines[j]
-                    prev_stripped = prev_line.strip()
-
-                    # Check for Flag { or PositionalArg { (but not pattern matching with ..)
-                    if ('Flag {' in prev_line or 'PositionalArg {' in prev_line) and '..' not in prev_line:
-                        in_struct = True
-                        # Get the indentation of the struct fields
-                        struct_indent = current_indent
-                        break
-
-                    # If we hit a closing brace that's not part of the same struct, break
-                    # Only break if the closing brace is at same or less indentation than our line
-                    if (prev_stripped == '},' or prev_stripped == '}' or prev_stripped == ');' or prev_stripped == ')'):
-                        prev_indent = len(prev_line) - len(prev_line.lstrip())
-                        if prev_indent <= current_indent:
-                            break
-
-                if in_struct:
-                    # Add custom_completion: None with same indentation
-                    indent = ' ' * struct_indent
-                    new_lines.append(f"{indent}custom_completion: None,")
-                    modified = True
-
-            i += 1
-
-        if modified:
-            new_content = '\n'.join(new_lines)
-            rs_file.write_text(new_content)
-            fixed_files += 1
-            print(f"  Fixed instantiations in {rs_file}")
-
-    return fixed_files
-
-
-def main():
-    # Use /testbed in Docker, or current directory if running locally
-    testbed = Path("/testbed") if Path("/testbed").exists() else Path(".")
-
-    print(f"Fixing custom_completion field... (testbed={testbed})")
-
-    # Fix signature.rs
-    sig_path = testbed / "crates/nu-protocol/src/signature.rs"
-    print(f"  Looking for signature.rs at {sig_path}")
-    if sig_path.exists():
-        fix_signature_rs(sig_path)
-    else:
-        print(f"  ERROR: signature.rs not found at {sig_path}")
-
-    # Fix all struct instantiations
-    fixed = fix_struct_instantiations(testbed)
-    print(f"Fixed {fixed} files with struct instantiations")
-
-    print("Done!")
-
-
-if __name__ == "__main__":
-    main()
