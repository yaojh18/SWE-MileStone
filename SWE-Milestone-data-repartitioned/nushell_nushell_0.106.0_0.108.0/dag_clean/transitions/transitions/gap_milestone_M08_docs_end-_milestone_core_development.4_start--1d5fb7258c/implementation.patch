+pub fn combined_type_string(types: &[Type], join_word: &str) -> Option<String> {
+    use std::fmt::Write as _;
+    match types {
+        [] => None,
+        [one] => Some(one.to_string()),
+        [one, two] => Some(format!("{one} {join_word} {two}")),
+        [initial @ .., last] => {
+            let mut out = String::new();
+            for ele in initial {
+                let _ = write!(out, "{ele}, ");
+            }
+            let _ = write!(out, "{join_word} {last}");
+            Some(out)
+        }
+    }
+}
