index 0000000000000000000000000000000000000000..f5c107f0218ec8eeb5b5021b18502b4925b73548
--- /dev/null
+++ b/crates/nu-utils/src/multilife.rs
@@ -0,0 +1,25 @@
+use std::ops::Deref;
+
+pub enum MultiLife<'out, 'local, T>
+where
+    'out: 'local,
+    T: ?Sized,
+{
+    Out(&'out T),
+    Local(&'local T),
+}
+
+impl<'out, 'local, T> Deref for MultiLife<'out, 'local, T>
+where
+    'out: 'local,
+    T: ?Sized,
+{
+    type Target = T;
+
+    fn deref(&self) -> &Self::Target {
+        match *self {
+            MultiLife::Out(x) => x,
+            MultiLife::Local(x) => x,
+        }
+    }
+}
