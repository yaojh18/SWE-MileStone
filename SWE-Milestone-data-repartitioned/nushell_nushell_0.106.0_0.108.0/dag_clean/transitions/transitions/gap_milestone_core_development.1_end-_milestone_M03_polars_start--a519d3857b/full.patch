-    [(which "gzip" | is-not-empty), { gzip $zipfile }]
-    [((which "tar" | is-not-empty) and $nu.os-info.name == "windows"), { tar $zipfile $filename }]
-    [(which "7z" | is-not-empty), { 7z $zipfile $filename }]
-    [(which "unzip" | is-not-empty), { unzip $zipfile $filename }]
