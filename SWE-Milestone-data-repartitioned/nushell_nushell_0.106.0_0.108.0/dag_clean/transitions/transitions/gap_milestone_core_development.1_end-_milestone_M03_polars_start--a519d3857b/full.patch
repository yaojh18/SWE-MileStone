+    use crate::is_windows_device_path;
+    use std::path::Path;
+
+    #[cfg_attr(not(windows), ignore = "only for Windows")]
+    #[test]
+    fn device_namespace() {
+        assert!(is_windows_device_path(Path::new(r"\\.\CON")))
+    }
+
+    #[cfg_attr(not(windows), ignore = "only for Windows")]
