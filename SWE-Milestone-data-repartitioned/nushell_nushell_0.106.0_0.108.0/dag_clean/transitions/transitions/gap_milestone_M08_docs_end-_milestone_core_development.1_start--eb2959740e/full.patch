+impl<'a> Display for Strategy<'a> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.0
+            .map(|s| write!(f, "--strategy={s}"))
+            .unwrap_or(Ok(()))
+    }
+}
+
+const TABLE_LEFT: &str = "{inner: [{a: 1}, {b: 2}]}";
+const TABLE_RIGHT: &str = "{inner: [{c: 3}]}";
