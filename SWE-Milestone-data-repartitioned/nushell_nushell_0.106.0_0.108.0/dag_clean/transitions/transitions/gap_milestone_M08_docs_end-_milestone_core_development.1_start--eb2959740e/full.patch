+fn merge_deep_tests<'a>(
+    #[case] strategy: impl Into<Option<&'a str>>,
+    #[case] left: &str,
+    #[case] right: &str,
+    #[case] expected: &str,
+) {
+    let strategy = Strategy(strategy.into());
+    let actual = nu!(format!("{left} | merge deep {strategy} {right} | to nuon"));
+    assert_eq!(actual.out, expected)
 }
