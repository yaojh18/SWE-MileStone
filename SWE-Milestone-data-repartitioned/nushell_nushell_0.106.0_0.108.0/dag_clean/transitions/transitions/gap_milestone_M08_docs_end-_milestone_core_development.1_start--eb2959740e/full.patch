-    try {
-        if $fast {
-            if ($features | is-empty) {
-                test --workspace --fast
-            } else {
-                test --features $features --fast
-            }
-        } else {
-            if ($features | is-empty) {
-                test --workspace
-            } else {
-                test --features $features
-            }
-        }
