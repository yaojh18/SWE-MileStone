+            PipelineData::ListStream(stream, ..) => stream
+                .into_iter()
+                .map(Value::unwrap_error)
+                .collect::<Result<Vec<_>, _>>()
+                .map(|vals| Value::list(vals, head)),
+            data => data.into_value(head),
+        })
+        .map_err(|error| chain_error_with_input(error, is_error, span))
