+)]
+// [ list, table supertype ]
+#[case("let foo = [ [{ a: 1, b: 2 }], [ [a]; [1] ] ];", "list<table<a: int>>")]
+// disjoint element types: any
+#[case("let foo = [[ [bar]; [1] ], [ { baz: 1 } ] ];", "list<any>")]
+// `bar: int` and `bar: number` are widened to table<bar: number>
+#[case(
