+// supertype of table values (records)
+#[case(
+    "let foo = [ [item]; [ {a: 1} ], [ {a: 1, b: 1 } ] ];",
+    "table<item: record<a: int>>"
+)]
+// disjoint table values: any
+#[case("let foo = [ [bar]; [1], [true] ];", "table<bar: any>")]
