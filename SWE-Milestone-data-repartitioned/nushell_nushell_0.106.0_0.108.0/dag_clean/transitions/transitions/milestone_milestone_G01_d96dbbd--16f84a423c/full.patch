-            ":black_circle:"
-        } else if $it.success {
-            ":green_circle:"
-        } else {
-            ":red_circle:"
-        }
-    }
-    | each {|it|
-        $"- ($it.emoji) `toolkit ($it.stage)`"
-    }
-    | to text
-}
