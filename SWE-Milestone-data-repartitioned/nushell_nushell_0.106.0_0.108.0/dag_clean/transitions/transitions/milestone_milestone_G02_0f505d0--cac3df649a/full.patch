index 0000000000000000000000000000000000000000..ca60df1b574206b1d345854dbb07fc0c4cc02999
--- /dev/null
+++ b/ast-grep/tests/__snapshots__/let-if-let-some-snapshot.yml
@@ -0,0 +1,32 @@
+id: let-if-let-some
+snapshots:
+  ? |
+    let completions_path = if let Some(mut path) = nu_path::data_dir() {
+      path.push("nushell");
+      path.push("completions");
+      path.into()
+    } else {
+      nu::path::PathBuf::new()
+    }
+  : fixed: |+
+      let completions_path = nu_path::data_dir().map(|mut path| {
+          path.push("nushell");
+          path.push("completions");
+          path.into()
+      })
+      .unwrap_or_else(|| {
+          nu::path::PathBuf::new()
+      });
+
+    labels:
+    - source: |-
+        let completions_path = if let Some(mut path) = nu_path::data_dir() {
+          path.push("nushell");
+          path.push("completions");
+          path.into()
+        } else {
+          nu::path::PathBuf::new()
+        }
+      style: primary
+      start: 0
+      end: 172
