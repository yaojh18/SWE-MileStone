+        Path::new("PRN"),
+        Path::new("AUX"),
+        Path::new("NUL"),
+        Path::new("COM1"),
+        Path::new("COM2"),
+        Path::new("COM3"),
+        Path::new("COM4"),
+        Path::new("COM5"),
+        Path::new("COM6"),
+        Path::new("COM7"),
+        Path::new("COM8"),
+        Path::new("COM9"),
+        Path::new("COM¹"),
+        Path::new("COM²"),
+        Path::new("COM³"),
+        Path::new("LPT1"),
+        Path::new("LPT2"),
+        Path::new("LPT3"),
+        Path::new("LPT4"),
+        Path::new("LPT5"),
+        Path::new("LPT6"),
+        Path::new("LPT7"),
+        Path::new("LPT8"),
+        Path::new("LPT9"),
+        Path::new("LPT¹"),
+        Path::new("LPT²"),
+        Path::new("LPT³"),
+    ];
+    if special_paths.contains(&path) {
+        return true;
+    }
