diff --git a/ast-grep/rules/format-in-nu-macro.yml b/ast-grep/rules/format-in-nu-macro.yml
new file mode 100644
index 0000000000000000000000000000000000000000..74b4939b7daf4bcc375b71a74d3f751661e9a2a7
--- /dev/null
+++ b/ast-grep/rules/format-in-nu-macro.yml
@@ -0,0 +1,22 @@
+# yaml-language-server: $schema=https://raw.githubusercontent.com/ast-grep/ast-grep/main/schemas/rust_rule.json
+
+id: format-in-nu-macro
+language: rust
+severity: off
+message: "`nu!` macro already supports format strings, use of `format!` is unnecessary"
+
+rule:
+  pattern:
+    context: $FORMAT!($$$_)
+    selector: identifier
+  kind: identifier
+  regex: "^format$"
+  inside:
+    stopBy: end
+    kind: token_tree
+    inside:
+      pattern: nu!($$$_)
+
+labels:
+  FORMAT:
+    style: primary
