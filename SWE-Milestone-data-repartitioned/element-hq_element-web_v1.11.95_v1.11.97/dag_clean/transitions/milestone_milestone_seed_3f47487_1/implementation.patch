index 0000000000000000000000000000000000000000..bf0e48c16a5f18a3d6f522b4fc28a13fdaa22474
--- /dev/null
+++ b/src/components/views/messages/EventContentBody.tsx
@@ -0,0 +1,210 @@
+/*
