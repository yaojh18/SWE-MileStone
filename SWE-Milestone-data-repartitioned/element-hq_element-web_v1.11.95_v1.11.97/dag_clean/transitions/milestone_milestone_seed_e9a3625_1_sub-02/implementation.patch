+.mx_RoomListItemView {
+    all: unset;
+    cursor: pointer;
+
+    &:hover {
+        background-color: var(--cpd-color-bg-action-secondary-hovered);
+    }
+
+    .mx_RoomListItemView_container {
+        padding-left: var(--cpd-space-2x);
+        font: var(--cpd-font-body-md-regular);
+        height: 100%;
