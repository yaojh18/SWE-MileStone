-            const root = this.roots.pop()!;
-            const rootElement = this.rootElements.pop();
-            const revertElement = this.revertElements.pop();
-            root.unmount();
-            if (revertElement) {
-                rootElement?.replaceWith(revertElement);
-            }
-        }
-    }
-}
