+                        className="mx_RoomList_List"
+                        rowRenderer={roomRendererMemoized}
+                        rowCount={rooms.length}
+                        rowHeight={48}
+                        height={height}
+                        width={width}
+                        scrollToIndex={activeIndex}
+                    />
+                )}
+            </AutoSizer>
+        </div>
+    );
+}
